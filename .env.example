# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored — never commit real keys.
#
# Supabase dashboard → Project Settings → API

# Safe to expose in the browser (read-only, limited by RLS policies).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Bypasses RLS — server and scripts only, never in a client component.
# Used by `npm run db:seed`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by app/sitemap.ts. Set to your live domain in production.
NEXT_PUBLIC_SITE_URL=https://elyrafashion.in

# ── Razorpay ───────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys → Generate Key.
# Use the rzp_test_* pair until you are ready to take real money.

# The key id is public — it is sent to the browser to open the checkout widget.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# SECRET. Signs and verifies payments — anyone with this can forge a
# "this order was paid" callback. Server only, never NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# SECRET, and a *different* secret from the key above. Set it when you create
# the webhook in Razorpay → Settings → Webhooks, pointing at
#   https://your-domain/api/webhooks/razorpay
# with the payment.captured and payment.failed events ticked.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Shiprocket ─────────────────────────────────────────────────────────────
# SECRET. Server-side only — powers /api/shipping/*.
# Create this user in Shiprocket → Settings → API → Configure.
# It is NOT your dashboard login.
SHIPROCKET_EMAIL=api-user@yourdomain.com
SHIPROCKET_PASSWORD=your-api-user-password

# Pin code of your pickup location, used for delivery estimates.
SHIPROCKET_PICKUP_PINCODE=400001

# Optional: pickup nickname as saved in Shiprocket (defaults to "Primary")
# SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: channel id if you push orders to a specific channel
# SHIPROCKET_CHANNEL_ID=
