# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored — never commit real keys.
#
# Supabase dashboard → Project Settings → API

# Safe to expose in the browser (read-only, limited by RLS policies).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Bypasses RLS — server and scripts only, never in a client component.
# Used by `npm run db:seed`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by app/sitemap.ts. Set to your live domain in production.
NEXT_PUBLIC_SITE_URL=https://elyrafashion.in

# ── Shiprocket ─────────────────────────────────────────────────────────────
# SECRET. Server-side only — powers /api/shipping/*.
# Create this user in Shiprocket → Settings → API → Configure.
# It is NOT your dashboard login.
SHIPROCKET_EMAIL=api-user@yourdomain.com
SHIPROCKET_PASSWORD=your-api-user-password

# Pin code of your pickup location, used for delivery estimates.
SHIPROCKET_PICKUP_PINCODE=400001

# Optional: pickup nickname as saved in Shiprocket (defaults to "Primary")
# SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: channel id if you push orders to a specific channel
# SHIPROCKET_CHANNEL_ID=
